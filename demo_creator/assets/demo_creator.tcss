/* ===== Colors and Variables (identical to demo_detail.tcss) ===== */
$accent: rgb(6, 100, 160);
$accent-dark: rgb(2, 50, 80);
$accent-light: rgb(220, 240, 255);
$text: rgb(220, 220, 220);
$text-muted: rgb(150, 150, 150);
$background: rgb(15, 15, 20);
$error: rgb(200, 60, 60);
$button-bg: rgb(45, 55, 80);
$button-text: rgb(230, 230, 230);
$button-text-focus: rgb(255, 255, 255);
$button-disabled-bg: rgb(40, 40, 50);
$button-disabled-text: rgb(90, 90, 120);

/* ===== Main Form Container (matches DemoDetailScreen) ===== */
#demo_detail_container {
    height: 100%;
    width: 100%;
    layout: vertical;
    background: $background;
    color: $text;
    padding: 1 2;
}

/* Screen Title */
#screen_title {
    height: 3;
    content-align: center middle;
    text-style: bold;
    border: tall $accent;
    background: $accent-dark;
    color: $accent-light;
    margin-bottom: 1;
}

/* Top buttons row */
#top_buttons_row {
    layout: horizontal;
    height: 3;
    margin-bottom: 1;
}
#top_buttons_row Button {
    margin-right: 2;
    border: round $accent;
    padding-left: 2;
    padding-right: 2;
    background: $button-bg;
    color: $button-text;
}
#top_buttons_row Button:focus {
    background: $accent;
    color: $button-text-focus;
    text-style: bold;
}
#top_buttons_row Button:disabled {
    background: $button-disabled-bg;
    color: $button-disabled-text;
}

/* Status label */
#status_label {
    height: 1;
    margin-bottom: 1;
    padding-left: 1;
}

/* Scroll container */
#demo_scroll_container {
    height: 1fr;
    layout: vertical;
    overflow-y: auto;
    padding: 1 2;
    border: solid $accent;
}

/* Labels and headers */
.label {
    text-style: bold;
    padding-left: 0;
    margin-top: 1;
}
.section_header {
    text-style: bold underline;
    margin-top: 1;
    margin-bottom: 1;
}
.step_label {
    text-style: bold underline;
    margin-bottom: 1;
}

/* Step Containers and Fields */
.step_container {
    border: solid $accent-dark;
    padding: 1 1;
    margin-bottom: 1;
    background: $background;
    height: auto;
}
.step_container > * {
    min-height: 1;
}
.step_field, .meta_data, .step_input {
    color: $text;
    padding-left: 2;
    margin-bottom: 1;
}

/* Remove Step Button Row */
.step_btn_row {
    margin-top: 1;
    margin-bottom: 0;
}
.remove_step_btn {
    color: $error;
    text-style: bold;
    margin-left: 1;
    margin-top: 0;
    margin-bottom: 0;
    background: transparent;
    border: none;
}

/* Input Fields */
Input {
    border: round $accent;
    padding-left: 1;
    padding-right: 1;
    margin-bottom: 1;
    background: $button-bg;
    color: $button-text;
}

/* Empty steps */
.empty_steps {
    padding-left: 2;
    color: $text-muted;
    text-style: italic;
}

/* Footer */
Footer {
    height: 1;
}
