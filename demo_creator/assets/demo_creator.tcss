/* ------ demo_creator.tcss ------ */

#demo_creator_form {
  width: 70%;
  max-width: 90;
  height: auto;
  align: center middle;
  background: #2b2b2b;
  border: round #444444;
  padding: 2 4;
}

#demo_creator_form Static {
  margin-top: 1;
  margin-bottom: 0;
}
#status {
  text-align: center;
  margin-top: 1;
  margin-bottom: 1;
}
#demo_creator_form Button {
  margin-top: 2;
  width: 100%;
}
