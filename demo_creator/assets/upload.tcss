/* ------ upload.tcss ------ */

#upload_form {
  width: 60%;
  max-width: 80;
  height: auto;
  align: center middle;
  background: #2b2b2b;
  border: round #444444;
  padding: 2 4;
}

#upload_status {
  text-align: center;
  margin-top: 1;
  margin-bottom: 1;
}

#upload_form Button {
  width: 100%;
  margin-top: 1;
}
#upload_form #cancel_upload {
  background: #7a3a3a;
  border: solid #9a4a4a;
}
#upload_form #cancel_upload:hover {
  background: #a04040;
  border: solid #a04040;
}
